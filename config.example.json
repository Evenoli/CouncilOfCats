{
  "shared_secret": "CHANGE_ME_TO_A_LONG_RANDOM_STRING",
  "local_orchestrator_url": "https://your-tunnel.example.com/council",

  "discord": {
    "bot_token": "YOUR_DISCORD_BOT_TOKEN",
    "channel_id": "YOUR_SOURCE_CHANNEL_ID",
    "admin_user_ids": ["YOUR_DISCORD_USER_ID"]
  },

  "ollama": {
    "base_url": "http://localhost:11434/v1",
    "model": "qwen2.5:32b-instruct"
  },

  "webhooks": {
    "chair-cat": "https://discord.com/api/webhooks/CHAIR_CAT_WEBHOOK",
    "barnaby": "https://discord.com/api/webhooks/BARNABY_WEBHOOK",
    "cleo": "https://discord.com/api/webhooks/CLEO_WEBHOOK",
    "pip": "https://discord.com/api/webhooks/PIP_WEBHOOK"
  },

  "hermes": {
    "enabled": true,
    "cli_command": "hermes",
    "home": "~/.hermes",
    "chronicler_profile": "council-chronicler",
    "curator_profile": "council-curator",
    "cat_profiles": ["barnaby", "cleo", "pip", "chair-cat"],
    "timeout_seconds": 900,
    "toolsets": ""
  },

  "orchestrator": {
    "host": "0.0.0.0",
    "port": 5000,
    "webhook_delay_seconds": 2,
    "log_days": 7
  }
}
