{
  "llm": {
    "provider": "gemini",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "api_key": "YOUR_GEMINI_API_KEY",
    "model": "gemini-2.5-flash"
  },

  "discord": {
    "bot_token": "YOUR_DISCORD_BOT_TOKEN",
    "read_channel_id": "YOUR_READ_CHANNEL_ID",
    "status_channel_id": "YOUR_STATUS_CHANNEL_ID",
    "admin_user_ids": ["YOUR_DISCORD_USER_ID"]
  },

  "webhooks": {
    "chair-cat": "https://discord.com/api/webhooks/CHAIR_CAT_WEBHOOK",
    "barnaby": "https://discord.com/api/webhooks/BARNABY_WEBHOOK",
    "cleo": "https://discord.com/api/webhooks/CLEO_WEBHOOK",
    "kiwi": "https://discord.com/api/webhooks/KIWI_WEBHOOK"
  },

  "cats": {
    "debate_order": ["barnaby", "cleo", "kiwi"],
    "display_names": {
      "chair-cat": "Chair Cat",
      "barnaby": "Barnaby",
      "cleo": "Cleo",
      "kiwi": "Kiwi"
    }
  },

  "council": {
    "log_days": 7,
    "webhook_delay_seconds": 2
  },

  "hermes": {
    "enabled": true,
    "cli_command": "hermes",
    "home": "~/.hermes",
    "chronicler_profile": "council-chronicler",
    "curator_profile": "council-curator",
    "cat_profiles": ["barnaby", "cleo", "kiwi", "chair-cat"],
    "timeout_seconds": 900,
    "toolsets": ""
  }
}
